# ── Database ────────────────────────────────────────────────────────────────────
POSTGRES_URL=

# ── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET=
ADMIN_SECRET=

# ── AI Tutor ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL=

# ── File Storage (Vercel Blob) ───────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Payments (Stripe payment links) ─────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_FOUNDER_COHORT_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_PREMIUM_PAYMENT_LINK=
NEXT_PUBLIC_SPONSORED_STUDENT_DONATION_LINK=

# ── Community ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
NEXT_PUBLIC_TELEGRAM_COMMUNITY_URL=

# ── Contact ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PARTNERSHIP_EMAIL=

# ── Weekly parent reports (Vercel cron) ──────────────────────────────────────────
# Secret Vercel sends as "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET=
# First day of the current cohort (YYYY-MM-DD) — used to compute the week number
# for auto-generated draft reports. Leave empty to disable auto-generation.
COHORT_START_DATE=

# ── Analytics (optional) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
