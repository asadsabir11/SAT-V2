# ── Database ────────────────────────────────────────────────────────────────────
POSTGRES_URL=

# ── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET=
ADMIN_SECRET=

# ── AI Tutor ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL=

# ── File Storage (Vercel Blob) ───────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Payments (Stripe Checkout — SAT "Pay by Card", instant unlock) ──────────────
# Secret key from the Stripe dashboard. Server-side only, never exposed to the browser.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint you create at
# https://dashboard.stripe.com/webhooks pointing to
# https://academy.thedigitaltutor.net/api/stripe/webhook, listening for
# checkout.session.completed.
STRIPE_WEBHOOK_SECRET=
# The Price ID (price_...) to charge for SAT full access. Works whether the
# price is one-time or recurring — Checkout mode is picked automatically.
STRIPE_PRICE_ID=

# ── Payments (manual — Pakistan, both SAT /unlock and O-Level /o-level/unlock) ──
# One shared bank account for both programs.
NEXT_PUBLIC_OLEVEL_BANK_NAME=
NEXT_PUBLIC_OLEVEL_BANK_ACCOUNT_TITLE=
NEXT_PUBLIC_OLEVEL_BANK_IBAN=
# JazzCash / Easypaisa numbers — SAT's /unlock page only; O-Level's shows
# "Contact us" placeholders until it gets its own.
NEXT_PUBLIC_PAYMENT_JAZZCASH=
NEXT_PUBLIC_PAYMENT_EASYPAISA=
# WhatsApp link shown as a fallback if a payment screenshot fails to upload.
NEXT_PUBLIC_PAYMENT_WHATSAPP_URL=

# ── Community ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
NEXT_PUBLIC_TELEGRAM_COMMUNITY_URL=

# ── Contact ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Weekly parent reports (Vercel cron) ──────────────────────────────────────────
# Secret Vercel sends as "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET=
# First day of the current cohort (YYYY-MM-DD) — used to compute the week number
# for auto-generated draft reports. Leave empty to disable auto-generation.
COHORT_START_DATE=
# Same as above, but for the O-Level/IGCSE cohort (separate start date since it
# runs on its own calendar). Leave empty to disable O-Level auto-generation.
OLEVEL_COHORT_START_DATE=

# ── Analytics (optional) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side conversion events (Purchase, fired only when an admin verifies
# payment — there's no browser present at that moment, so these go server-side
# instead of through the browser pixel/gtag). Both optional; each is a no-op
# until its token is set.
META_CONVERSIONS_API_TOKEN=
GA4_API_SECRET=

# ── O-Level WhatsApp CTA ──────────────────────────────────────────────────────────
# Digits only, country code first, no "+" (e.g. 923001234567) — used to build
# a wa.me deep link with a prefilled message on O-Level pages.
NEXT_PUBLIC_OLEVEL_WHATSAPP_NUMBER=
